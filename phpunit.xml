<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Emergency switches must be UNSET in tests: an .env copied from
             .env.example would otherwise act as an environment override and
             beat the config() values the tests set (Phase C1 precedence). -->
        <env name="AI_ENABLED" value=""/>
        <env name="AI_CATALOG_SOURCE" value=""/>
        <env name="BILLING_ENFORCE" value=""/>
        <env name="AI_CREDENTIALS_MODE" value=""/>
        <env name="AI_ROUTING_MODE" value=""/>
        <env name="CREDENTIALS_KEY" value=""/>
        <env name="CREDENTIALS_PREVIOUS_KEYS" value=""/>
        <!-- Durable memory is fail-closed without keys; the suite gets fixed test
             keys so the real sealed/HMAC path is exercised everywhere, and the
             unavailable case is proven by nulling the config in its own test. -->
        <env name="MEMORY_KEY" value="base64:251MGyf9yPbLJeYJsPKgkyAQQH9ERb3WM/4wwFLW2xw="/>
        <env name="MEMORY_PREVIOUS_KEYS" value=""/>
        <env name="MEMORY_FINGERPRINT_KEY" value="base64:x3Zpdubn+FbBhzk4p2KK2r8EqfO/ubytx/JDgSwqB04="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
