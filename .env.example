APP_NAME=SANAD
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Internal storage timezone is always UTC.
APP_TIMEZONE=UTC

# Arabic first (RTL), English as fallback.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# SANAD defaults (see config/sanad.php)
DEFAULT_USER_TIMEZONE=Asia/Hebron
DEFAULT_CURRENCY=ILS

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- PostgreSQL (local defaults match docker-compose.yml) ----
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sanad
DB_USERNAME=sanad
DB_PASSWORD=secret

# Sessions, cache and queues run on Redis.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ---- Redis (local defaults match docker-compose.yml) ----
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Horizon queue supervisor
HORIZON_PREFIX=sanad_horizon

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================================
# Integrations — PLACEHOLDERS ONLY. Do NOT commit real secrets, tokens,
# app secrets or real phone numbers. Never paste an Access Token into git
# or into a chat. See docs/WHATSAPP_INTEGRATION.md.
# ============================================================================

# ---- WhatsApp Cloud API (text transport) ----
# Keep disabled until real credentials are provisioned outside the repo.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_REQUEST_TIMEOUT=10

# ---- OpenAI (not wired up yet) ----
OPENAI_API_KEY=
