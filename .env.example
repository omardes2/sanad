APP_NAME=SANAD
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Internal storage timezone is always UTC.
APP_TIMEZONE=UTC

# Arabic first (RTL), English as fallback.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# SANAD defaults (see config/sanad.php)
DEFAULT_USER_TIMEZONE=Asia/Hebron
DEFAULT_CURRENCY=ILS

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- PostgreSQL (local defaults match docker-compose.yml) ----
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sanad
DB_USERNAME=sanad
DB_PASSWORD=secret

# Sessions, cache and queues run on Redis.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ---- Redis (local defaults match docker-compose.yml) ----
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Horizon queue supervisor
HORIZON_PREFIX=sanad_horizon

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================================
# Integrations — PLACEHOLDERS ONLY. Do NOT commit real secrets, tokens,
# app secrets or real phone numbers. Never paste an Access Token into git
# or into a chat. See docs/WHATSAPP_INTEGRATION.md.
# ============================================================================

# ---- WhatsApp Cloud API (text transport) ----
# Keep disabled until real credentials are provisioned outside the repo.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_REQUEST_TIMEOUT=10

# ---- OpenAI (not wired up yet) ----
OPENAI_API_KEY=

# ---- AI Orchestrator ----
# Keep disabled until a provider key is set. When disabled, replies come from
# the deterministic placeholder (no external calls). See docs/AI_ORCHESTRATOR.md.
AI_ENABLED=false
AI_PROVIDER=groq
AI_FAILURE_BEHAVIOR=retry
AI_HISTORY_LIMIT=10
AI_TIMEOUT=20
AI_MAX_OUTPUT_TOKENS=600
AI_TEMPERATURE=0.5
# AI_FALLBACK_MESSAGE=
# AI_PERSONA=

# Groq (first provider — OpenAI-compatible)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (optional — pin a CURRENT non-deprecated model in GEMINI_MODEL)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=

# Ollama (optional — local, private; no key needed)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=

# ---- Billing / Subscriptions / Usage ----
# Enforcement is off by default; turn on in production after seeding plans.
BILLING_ENFORCE=false
BILLING_AUTO_TRIAL=true
BILLING_DEFAULT_PLAN=free
# Currency for subscription plan prices (independent of app default currency)
BILLING_CURRENCY=USD
# BILLING_UPGRADE_URL=            # placeholder upgrade link (later phase)
# BILLING_LIMIT_MESSAGE=  BILLING_DISABLED_MESSAGE=
# Cost-accounting rates — configurable, default 0 (do NOT hard-code provider prices)
BILLING_COST_CURRENCY=USD
COST_AI_REPLY=0
COST_AI_INPUT_PER_1K=0
COST_AI_OUTPUT_PER_1K=0
COST_WA_INBOUND=0
COST_WA_OUTBOUND=0
