APP_NAME=SANAD
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Internal storage timezone is always UTC.
APP_TIMEZONE=UTC

# Arabic first (RTL), English as fallback.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# SANAD defaults (see config/sanad.php)
DEFAULT_USER_TIMEZONE=Asia/Hebron
DEFAULT_CURRENCY=ILS

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- PostgreSQL (local defaults match docker-compose.yml) ----
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sanad
DB_USERNAME=sanad
DB_PASSWORD=secret

# Sessions, cache and queues run on Redis.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ---- Redis (local defaults match docker-compose.yml) ----
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Horizon queue supervisor
HORIZON_PREFIX=sanad_horizon

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================================
# Integrations — PLACEHOLDERS ONLY. Do NOT commit real secrets, tokens,
# app secrets or real phone numbers. Never paste an Access Token into git
# or into a chat. See docs/WHATSAPP_INTEGRATION.md.
# ============================================================================

# ---- WhatsApp Cloud API (text transport) ----
# Keep disabled until real credentials are provisioned outside the repo.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_REQUEST_TIMEOUT=10

# Reminder delivery (scheduler). Delivery is an EXTERNAL write with a bounded
# at-least-once guarantee: at most 2 physical sends per reminder, never more.
REMINDERS_DELIVERY_ENABLED=true
REMINDER_MAX_LATENESS_MINUTES=60
REMINDER_DISPATCH_BATCH=100
REMINDER_LEASE_SECONDS=300

# A reminder is a PROACTIVE message. Outside the customer-service window a
# free-form text is not permitted and an approved template is required. Leave
# these empty/false until a real template is approved on the provider side —
# no template name is ever invented in code, and without one a reminder outside
# the window fails closed with `template_required` rather than being gambled.
WHATSAPP_FREE_FORM_WINDOW_HOURS=24
WHATSAPP_REMINDER_TEMPLATE_READY=false
WHATSAPP_REMINDER_TEMPLATE_NAME=
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=ar

# ---- Voice notes / transcription (Phase H) ----
# A voice note is TRANSCRIBED, not stored: the audio is downloaded to a private
# temp disk, measured, sent once to the transcription provider and deleted in a
# `finally` — success, failure or exception alike. The transcript lives in the
# message's own text, under the same permission typed message content has.
#
# Off ⇒ a voice note is still accepted and stored, and refused with a bounded,
# localized reason. It is never silently dropped.
VOICE_TRANSCRIPTION_ENABLED=true

# V1 is WhatsApp VOICE NOTES, not generic audio: an `audio` message without the
# platform's own `voice: true` flag is a file the subscriber attached, and is
# refused rather than quietly widening the phase into music and podcasts.
VOICE_REQUIRE_VOICE_FLAG=true

# The cheap refusals, in the order they are applied. The byte ceiling is checked
# against the provider's declared file size BEFORE downloading and against the
# bytes that actually arrived; the duration ceiling is measured from the audio
# itself before the paid request. A byte ceiling is NOT a duration limit.
VOICE_MAX_BYTES=8388608
VOICE_MAX_DURATION_SECONDS=300

# PHYSICAL provider requests per voice note. Two, and never more: an UNKNOWN
# outcome may be retried exactly once. This is a bounded at-least-once, not
# exactly-once — a provider can process and charge for audio we cannot prove it
# received, and a persisted transcript is what prevents a replay.
VOICE_MAX_ATTEMPTS=2
VOICE_LEASE_SECONDS=300
VOICE_SWEEP_BATCH=50

# The PRIVATE disk the audio occupies for the seconds it exists. Never a public
# disk, never exposed as a URL, never written to `messages.media_path`.
VOICE_TEMP_DISK=local
VOICE_TEMP_DIRECTORY=voice-tmp

# ---- Durable personal memory (Phase G) ----
# Memory is FAIL-CLOSED: without MEMORY_KEY and MEMORY_FINGERPRINT_KEY Sanad
# stores no memory, reads none, and puts none in a prompt. Plaintext memory and
# an unkeyed fingerprint are not acceptable fallbacks, so there is no such path.
#
# Both keys are INDEPENDENT of APP_KEY and of each other (base64 of 32 random
# bytes, like APP_KEY). MEMORY_KEY encrypts `memories.content` at rest with
# AES-256-GCM; MEMORY_FINGERPRINT_KEY is the MAC key behind duplicate detection,
# and it is separate on purpose — a bare digest of a memory would let anyone
# holding the database confirm a guessed memory without the encryption key.
#
# ROTATION: put the new key in MEMORY_KEY, the old one(s) in
# MEMORY_PREVIOUS_KEYS, and deploy. New memories seal with the new key and rows
# sealed with a previous one still open. There is NO re-encryption pass in this
# phase, so a previous key must be RETAINED for as long as any row is still
# sealed with it; dropping it — or losing MEMORY_KEY with no previous entry —
# makes those memories permanently unreadable. That is the honest cost of
# encrypting them, and the reason an unreadable row is skipped rather than
# guessed at.
# MEMORY_KEY=
# MEMORY_PREVIOUS_KEYS=
# MEMORY_FINGERPRINT_KEY=

# Bounded storage. AT CAPACITY A NEW MEMORY IS REFUSED — nothing the subscriber
# never asked to forget is ever evicted to make room.
MEMORY_MAX_ACTIVE=50
MEMORY_MAX_CONTENT_CHARS=300

# The prompt budget. Both bounds apply; whichever binds first wins.
MEMORY_PROMPT_LIMIT=12
MEMORY_PROMPT_MAX_CHARS=1200

# ---- AI Orchestrator ----
# Keep disabled until a provider key is set. When disabled, replies come from
# the deterministic placeholder (no external calls). See docs/AI_ORCHESTRATOR.md.
# AI_PROVIDER is the PREFERRED provider; the router falls through to any other
# configured provider (e.g. openai ⇄ groq) that supports the operation.
# Emergency switch: when set here it wins over the Sanad Admin setting
# (ai.enabled) and the dashboard shows it as forced by the environment.
AI_ENABLED=false
AI_PROVIDER=groq
AI_FAILURE_BEHAVIOR=retry
AI_HISTORY_LIMIT=10
AI_TIMEOUT=20
AI_MAX_OUTPUT_TOKENS=600
AI_TEMPERATURE=0.5
# Catalog source (Phase B2): auto | database | config. "auto" uses the database
# catalog once it has enabled models, otherwise the config catalog (today's
# behaviour). AI_PROVIDER stays the preferred provider in every mode.
# EMERGENCY OVERRIDE ONLY (Phase C1): when set here it wins over the value
# managed from Sanad Admin. Leave it unset so the admin setting applies.
# AI_CATALOG_SOURCE=config

# Phase C3 — credential vault. Leave unset until the vault cutover is approved.
# CREDENTIALS_KEY is INDEPENDENT of APP_KEY (base64 of 32 random bytes).
# AI_CREDENTIALS_MODE is an emergency override of the ai.credentials_mode
# setting: "env" = environment keys only (rollback), "vault" = vault first.
# CREDENTIALS_KEY=
# CREDENTIALS_PREVIOUS_KEYS=
# AI_CREDENTIALS_MODE=env

# Phase C4 — routing mode emergency override: "env" = AI_PROVIDER governs
# (rollback), "db" = the is_primary provider governs. Leave unset.
# AI_ROUTING_MODE=env
# Cost guardrail foundation (off): max known estimated cost per request, e.g. 0.01
# AI_MAX_COST_PER_REQUEST=
# AI_FALLBACK_MESSAGE=
# AI_PERSONA=

# OpenAI (primary provider). ORGANIZATION/PROJECT are optional scoping headers.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ORGANIZATION=
OPENAI_PROJECT=

# Groq (optional / fallback provider — OpenAI-compatible)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Speech-to-text model for voice notes. Left EMPTY on purpose: with no
# transcription model catalogued there is no `transcription` route, and a voice
# note is refused with a bounded reason instead of being charged to a model no
# operator chose. Set it to enable transcription.
GROQ_TRANSCRIPTION_MODEL=

# Gemini (optional — pin a CURRENT non-deprecated model in GEMINI_MODEL)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=

# Ollama (optional — local, private; no key needed)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=

# ---- Billing / Subscriptions / Usage ----
# Enforcement is off by default; turn on in production after seeding plans.
BILLING_ENFORCE=false
BILLING_AUTO_TRIAL=true
BILLING_DEFAULT_PLAN=free
# Currency new plans default to (prices are managed from the Plans page).
BILLING_CURRENCY=USD
# BILLING_UPGRADE_URL=            # placeholder upgrade link (later phase)
# BILLING_LIMIT_MESSAGE=  BILLING_DISABLED_MESSAGE=
# Cost-accounting rates — configurable, default 0 (do NOT hard-code provider prices)
BILLING_COST_CURRENCY=USD
COST_AI_REPLY=0
COST_AI_INPUT_PER_1K=0
COST_AI_OUTPUT_PER_1K=0
COST_WA_INBOUND=0
COST_WA_OUTBOUND=0
